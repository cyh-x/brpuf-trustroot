# build_pdlro.tcl — 挑战可编程 RO Strong PUF (v6.0) AX7020 位流构建
#   环 = 1 LUT2 门 + 64 LUT6 PDL 级 (u_tn + g_stage[0..62].u_ps) + TFF, 全部锁
#   进单列连续 slice; 环是组合环路 -> 沿用 RO 版 LUTLP 降级 + 环路豁免。
set root [file normalize [file join [file dirname [info script]] ..]]
puts ">> ROOT = $root"

# ---- 0) IP (已存在则复用) ----
if {[llength [glob -nocomplain $root/pr_out/ip_pr.gen/sources_1/ip/*/*.dcp]] > 0} {
    puts ">> IP_REUSE: IP dcps already exist"
} else {
    create_project ip_pr $root/pr_out -part xc7z020clg400-1 -force
    create_ip -name jtag_axi -vendor xilinx.com -library ip -module_name jtag_axi
    create_ip -name processing_system7 -vendor xilinx.com -library ip -module_name ps7_0
    foreach {k v} {
        CONFIG.PCW_FPGA0_PERIPHERAL_FREQMHZ  100
        CONFIG.PCW_FCLK_CLK0_BUF             TRUE
        CONFIG.PCW_EN_CLK0_PORT              1
        CONFIG.PCW_USE_M_AXI_GP0             0
    } {
        if {[catch { set_property -name $k -value $v -objects [get_ips ps7_0] } e]} {
            puts ">> PS7_SET_WARN $k=$v : $e"
        } else { puts ">> PS7_SET_OK   $k=$v" }
    }
    generate_target all [get_ips jtag_axi]
    generate_target all [get_ips ps7_0]
    synth_ip [get_ips jtag_axi]
    synth_ip [get_ips ps7_0]
    close_project
}

set jceldcp [lindex [concat \
  [glob -nocomplain $root/pr_out/ip_pr.gen/sources_1/ip/jtag_axi/jtag_axi.dcp] \
  [glob -nocomplain $root/pr_out/ip_pr.srcs/sources_1/ips/jtag_axi/jtag_axi.dcp]] 0]
if {$jceldcp eq ""} { error "jtag_axi OOC dcp not found" }
set ps7dcp [lindex [glob -nocomplain $root/pr_out/ip_pr.gen/sources_1/ip/ps7_0/ps7_0.dcp] 0]
if {$ps7dcp eq ""} { error "ps7_0 OOC dcp not found" }
set ps7stub [lindex [glob -nocomplain $root/pr_out/ip_pr.gen/sources_1/ip/ps7_0/*stub*.v] 0]
if {$ps7stub eq ""} { error "ps7_0 stub not found" }
puts ">> IP DCP: jtag_axi=$jceldcp  ps7_0=$ps7dcp"

# ---- 1) XDC ----
set f [open $root/scripts/pins.xdc w]
puts $f "# auto-generated by build_pdlro.tcl (PS7 FCLK_CLK0=100MHz)"
puts $f "create_clock -period 10.000 -name sys_clk \[get_pins u_ps/FCLK_CLK0\]"
close $f

# ---- 2) RTL + 综合 ----
read_verilog [list \
  $root/rtl/pdl_ring.v \
  $root/rtl/pdlro_axi.v \
  $root/rtl/pdlro_eval_top.v \
  $root/scripts/jtag_axi_stub.v \
  $ps7stub ]
read_xdc $root/scripts/pins.xdc
synth_design -top pdlro_eval_top -part xc7z020clg400-1

# ---- 3) 结构闸门 ----
set l6   [get_cells -hier -quiet -filter {NAME =~ "*u_ring*" && REF_NAME == LUT6}]
set l2   [get_cells -hier -quiet -filter {NAME =~ "*u_ring/u_gate" && REF_NAME == LUT2}]
set tff  [get_cells -hier -quiet -filter {NAME =~ "*u_ring*" && REF_NAME =~ FD*}]
set rnets [get_nets -hierarchical -quiet -filter {NAME =~ "*u_ring/n*"}]
puts ">> PDLRO_CHECK: LUT6 stages = [llength $l6] (expect 64)"
puts ">> PDLRO_CHECK: LUT2 gate   = [llength $l2] (expect 1)"
puts ">> PDLRO_CHECK: TFF FF      = [llength $tff] (expect 1)"
puts ">> PDLRO_CHECK: ring nets   = [llength $rnets] (expect 65)"
if {[llength $l6] != 64}    { error "PDLRO GATE FAIL: LUT6 [llength $l6] != 64 (chain collapsed?)" }
if {[llength $l2] != 1}     { error "PDLRO GATE FAIL: LUT2 gate [llength $l2] != 1" }
if {[llength $tff] != 1}    { error "PDLRO GATE FAIL: TFF [llength $tff] != 1" }
if {[llength $rnets] < 65}  { error "PDLRO GATE FAIL: ring nets [llength $rnets] < 65" }
foreach c $l6 {
    set ini [get_property INIT $c]
    if {![string match -nocase "*5555555555555555" $ini]} {
        error "PDLRO GATE FAIL: INIT of [get_property NAME $c] = $ini"
    }
}
puts ">> PDLRO_CHECK: INIT all 0x5555..5555 OK"
set gini [get_property INIT [lindex $l2 0]]
if {![string match -nocase "*7" $gini]} { error "PDLRO GATE FAIL: gate INIT=$gini (expect 4'h7)" }
puts ">> PDLRO_CHECK: gate INIT=7 OK"

# ---- 3b) 硬宏: 单列 X84, Y40 = 门+tune, Y41..Y103 = 63 级, Y104 = TFF ----
set col 84
set y0  40
set gate [lindex [get_cells -hier -quiet -filter {NAME =~ "*u_ring/u_gate"}] 0]
set tn   [lindex [get_cells -hier -quiet -filter {NAME =~ "*u_ring*u_tn*"}] 0]
set_property LOC "SLICE_X${col}Y$y0" $gate; set_property BEL A6LUT $gate
set_property LOC "SLICE_X${col}Y$y0" $tn;   set_property BEL B6LUT $tn
# 级单元: 收集后按名称解析索引
array set stg {}
foreach c [get_cells -hier -quiet -filter {NAME =~ "*u_ring*g_stage*" && REF_NAME == LUT6}] {
    set nm [get_property NAME $c]
    if {![regexp {g_stage\[(\d+)\]\.u_ps$} $nm -> si]} { continue }
    set stg($si) $c
}
if {[array size stg] != 63} { error "PDLRO PLACE: parsed [array size stg] stages != 63" }
for {set i 0} {$i < 63} {incr i} {
    set y [expr {$y0 + 1 + $i}]
    set_property LOC "SLICE_X${col}Y$y" $stg($i); set_property BEL A6LUT $stg($i)
}
set tffc [lindex $tff 0]
set_property LOC "SLICE_X${col}Y[expr {$y0+64}]" $tffc; set_property BEL AFF $tffc
puts ">> PDLRO_PLACE_OK ring locked to column X${col} Y${y0}..[expr {$y0+64}]"

# 环路豁免 (环 = 组合环路)
catch { set_property SEVERITY {Warning} [get_drc_checks LUTLP-1] } e1
puts ">> DRC LUTLP-1 -> Warning : $e1"
set_property ALLOW_COMBINATORIAL_LOOPS TRUE $rnets
puts ">> ALLOW_COMBINATORIAL_LOOPS set on [llength $rnets] ring nets"

# ---- 4) 合入真实 IP ----
read_checkpoint -cell u_jtag $jceldcp
read_checkpoint -cell u_ps   $ps7dcp

# ---- 5) 实现 ----
opt_design
place_design
route_design
report_timing_summary -file $root/logs/timing.rpt
report_utilization    -file $root/logs/util.rpt

# ---- 6) 实现后复检 ----
set l6p [get_cells -hier -quiet -filter {NAME =~ "*u_ring*" && REF_NAME == LUT6}]
puts ">> PDLRO_POSTIMPL: LUT6 = [llength $l6p] (expect 64)"
if {[llength $l6p] != 64} { error "PDLRO GATE FAIL: post-impl [llength $l6p] != 64" }

# ---- 7) 位流 ----
write_checkpoint -force $root/pr_out/pdlro_impl.dcp
write_bitstream -force $root/pr_out/pdlro_ax7020.bit
set bit $root/pr_out/pdlro_ax7020.bit
if {![file exists $bit]} { error "bitstream missing: $bit" }
puts ">> BIT=$bit"
puts ">> BUILD_DONE"
