# build_ro.tcl — RO-pair Strong PUF AX7020 位流构建 (v3, 显式 LUT1 原语版)
#   前提: 工作区必须是纯 ASCII 路径 (中文路径会让 jtag_axi IP 的 ttcl 生成失败)
#   平台: ALINX AX7020 = xc7z020clg400-1, Vivado 2026.1, FCLK_CLK0=100MHz
#   用法: vivado.bat -mode batch -source scripts/build_ro.tcl  (经 build_ro_ascii.sh 调用)
#
# 结构闸门 (v3 加固, 2026-10-29):
#   旧闸门只数 "chain*" 网数, 而综合器把反相链折叠成单个 LUT2 后, 31 级 chain 网
#   变成悬空网, 网数仍然够 -> 闸门假通过, 板子上 256 个 RO 计数全 0。
#   新闸门要求: 每 RO 32 个 LUT1 (INIT=1) + 1 个 LUT2 门 + 采样检查无悬空链网。

set root [file normalize [file join [file dirname [info script]] ..]]
puts ">> ROOT = $root"

# ---- 0) IP (已存在则复用) ----
if {[llength [glob -nocomplain $root/pr_out/ip_pr.gen/sources_1/ip/*/*.dcp]] > 0} {
    puts ">> IP_REUSE: IP dcps already exist"
} else {
    create_project ip_pr $root/pr_out -part xc7z020clg400-1 -force
    create_ip -name jtag_axi -vendor xilinx.com -library ip -module_name jtag_axi
    create_ip -name processing_system7 -vendor xilinx.com -library ip -module_name ps7_0
    foreach {k v} {
        CONFIG.PCW_FPGA0_PERIPHERAL_FREQMHZ  100
        CONFIG.PCW_FCLK_CLK0_BUF             TRUE
        CONFIG.PCW_EN_CLK0_PORT              1
        CONFIG.PCW_USE_M_AXI_GP0             0
    } {
        if {[catch { set_property -name $k -value $v -objects [get_ips ps7_0] } e]} {
            puts ">> PS7_SET_WARN $k=$v : $e"
        } else { puts ">> PS7_SET_OK   $k=$v" }
    }
    generate_target all [get_ips jtag_axi]
    generate_target all [get_ips ps7_0]
    synth_ip [get_ips jtag_axi]
    synth_ip [get_ips ps7_0]
    close_project
}

set jceldcp [lindex [concat \
  [glob -nocomplain $root/pr_out/ip_pr.gen/sources_1/ip/jtag_axi/jtag_axi.dcp] \
  [glob -nocomplain $root/pr_out/ip_pr.srcs/sources_1/ips/jtag_axi/jtag_axi.dcp]] 0]
if {$jceldcp eq ""} { error "jtag_axi OOC dcp not found" }
set ps7dcp [lindex [glob -nocomplain $root/pr_out/ip_pr.gen/sources_1/ip/ps7_0/ps7_0.dcp] 0]
if {$ps7dcp eq ""} { error "ps7_0 OOC dcp not found" }
set ps7stub [lindex [glob -nocomplain $root/pr_out/ip_pr.gen/sources_1/ip/ps7_0/*stub*.v] 0]
if {$ps7stub eq ""} { error "ps7_0 stub not found" }
puts ">> IP DCP: jtag_axi=$jceldcp  ps7_0=$ps7dcp"

# ---- 1) XDC (只放时钟) ----
set f [open $root/scripts/pins.xdc w]
puts $f "# auto-generated by build_ro.tcl (PS7 FCLK_CLK0=100MHz)"
puts $f "create_clock -period 10.000 -name sys_clk \[get_pins u_ps/FCLK_CLK0\]"
close $f

# ---- 2) RTL + 综合 (全 Verilog; RO 用 UNISIM 原语, 不再读 VHDL) ----
read_verilog [list \
  $root/rtl/ropuf_axi.v \
  $root/rtl/ropuf_eval_top.v \
  $root/rtl/ro_ring.v \
  $root/scripts/jtag_axi_stub.v \
  $ps7stub ]
read_xdc $root/scripts/pins.xdc
synth_design -top ropuf_eval_top -part xc7z020clg400-1

# ---- 3) 结构核查闸门 (v3) ----
#   RO 存活证据: 每 RO 32 个 LUT1(INIT=1) 反相器 + 1 个 LUT2(INIT=7) 使能门 + 1 个采样 TFF
set invs  [get_cells -hier -quiet -filter {NAME =~ *g_inst*u_ro*g_inv* && REF_NAME == LUT1}]
set gates [get_cells -hier -quiet -filter {NAME =~ *g_inst*u_ro* && REF_NAME == LUT2}]
set tffs  [get_cells -hier -quiet -filter {NAME =~ *g_inst*u_ro* && REF_NAME =~ FD*}]
set ronets [get_nets -hierarchical -quiet -filter {NAME =~ *u_ro/ch*}]
puts ">> ROPUF_CHECK: inverter LUT1 = [llength $invs] (expect 8192 = 256x32)"
puts ">> ROPUF_CHECK: enable  LUT2 = [llength $gates] (expect 256)"
puts ">> ROPUF_CHECK: sample  TFF  = [llength $tffs] (expect 256)"
puts ">> ROPUF_CHECK: chain nets   = [llength $ronets] (expect 8448 = 256x33)"
if {[llength $invs]  != 8192} { error "ROPUF GATE FAIL: LUT1 [llength $invs] != 8192 (chain collapsed)" }
if {[llength $tffs]  != 256}  { error "ROPUF GATE FAIL: TFF [llength $tffs] != 256" }
if {[llength $ronets] < 8448} { error "ROPUF GATE FAIL: chain nets [llength $ronets] < 8448" }

# 悬空网抽查: 任意一级被优化掉都会留下 0 pin 的 net (旧版漏检的正是这个)
set bad 0
set checked 0
foreach gi {0 1 2 3 4 5 6 7} {
    set pref [format "u_spuf/g_inst\[%d\].u_ro/ch" $gi]
    foreach n $ronets {
        set nm [get_property NAME $n]
        if {[string first $pref $nm] != 0} { continue }
        incr checked
        if {[llength [get_pins -quiet -of_objects $n]] < 2} {
            incr bad
            if {$bad <= 6} { puts ">> ROPUF_DANGLING $nm" }
        }
    }
}
puts ">> ROPUF_CHECK: dangling scan $checked nets, bad=$bad"
if {$bad > 0} { error "ROPUF GATE FAIL: $bad dangling chain nets (chain collapsed)" }

catch { set_property SEVERITY {Warning} [get_drc_checks LUTLP-1] } e1
puts ">> DRC LUTLP-1 -> Warning : $e1"
if {[llength $ronets] > 0} {
    set_property ALLOW_COMBINATORIAL_LOOPS TRUE $ronets
    puts ">> ALLOW_COMBINATORIAL_LOOPS set on [llength $ronets] RO nets"
} else {
    puts ">> ROPUF_LOOP_WARN: no chain nets matched - bitgen DRC may fail"
}

# ---- 3c) 硬宏布局 (HARD MACRO, 2026-10-29) ----
#   问题: 自由布局下 256 个 RO 的 34 个 LUT 散落全片, 频率跨度 12-48MHz; 这一
#   设计性差异在两块板上完全相同, 把芯片间的工艺差异完全淹没 (唯一性 7.8%)。
#   做法 (参照上游 ro_puf_repo 的 hard-macro 思路 + 4x4-apuf 的手工放置):
#     每个 RO 固定占同一列连续 10 个 slice, 形态逐位相同:
#       row 0..7 : 32 个反相器 LUT1, 每 slice 4 个 (A6/B6/C6/D6), 沿列逐级跳 1 slice
#       row 8    : 使能门 LUT2 (A6) + 2 个辅助反相器 (B6/C6)
#       row 9    : 采样 TFF (AFF)
#     阵列: 114/88/54 三段 (共 256), 每段落在各自时钟区域内, 不跨区域:
#       段 0: k 0..113   -> 列 0..113,  Y1..10   (区域 Y0, 全 114 列可用)
#       段 1: k 114..201 -> 列 26..113, Y51..60  (区域 Y1, 列 0..25 无 slice)
#       段 2: k 202..255 -> 列 26..79,  Y101..110(区域 Y2)
#     占用率 = 256x10 / 13300 = 19% (单区域堆叠曾达 87%, 布线严重拥塞, 已放弃)。
#     每段 RO 数为偶数 -> 配对 (2k,2k+1) 恒同一段、相邻列, 几何完全对称。
set bels {A6LUT B6LUT C6LUT D6LUT}
set allro [get_cells -hier -quiet -filter {NAME =~ *g_inst*u_ro*}]
array set rocells {}
foreach c $allro {
    set nm [get_property NAME $c]
    if {![regexp {^u_spuf/g_inst\[(\d+)\]\.u_ro/(.+)$} $nm -> rk sub]} { continue }
    lappend rocells($rk) [list $sub $c]
}
puts ">> HARDMACRO: ro instances found = [array size rocells] (expect 256)"
if {[array size rocells] != 256} { error "HARDMACRO: rocells != 256" }

set nloc 0
# 从真实 site 列表组槽位 (器件列有空洞, 不能假设连续): 每段取 10 行全可用的列, 截断到偶数
set sites_all [get_sites -quiet -filter {SITE_TYPE == "SLICEL" || SITE_TYPE == "SLICEM"}]
array set colrows {}
foreach s $sites_all {
    if {[regexp {SLICE_X(\d+)Y(\d+)} [get_property NAME $s] -> x y]} { lappend colrows($x) $y }
}
set slots {}
foreach b {1 51 101} {
    set ok {}
    foreach x [lsort -integer [array names colrows]] {
        set good 1
        for {set d 0} {$d < 10} {incr d} {
            if {[lsearch -integer $colrows($x) [expr {$b+$d}]] < 0} { set good 0; break }
        }
        if {$good} { lappend ok $x }
    }
    set n [llength $ok]
    if {$n % 2 == 1} { incr n -1 }
    for {set i 0} {$i < $n} {incr i} { lappend slots [list [lindex $ok $i] $b] }
}
puts ">> HARDMACRO: candidate slots = [llength $slots] (need 256)"
if {[llength $slots] < 256} { error "HARDMACRO: only [llength $slots] slots" }
set use [lrange $slots 0 255]
puts ">> HARDMACRO: slot0=[lindex $use 0] slot1=[lindex $use 1] slot255=[lindex $use end]"

for {set k 0} {$k < 256} {incr k} {
    if {![info exists rocells($k)]} { error "HARDMACRO: RO $k missing" }
    lassign [lindex $use $k] col yb
    set helpers {}
    set ffcell ""
    set gatecell ""
    foreach pair $rocells($k) {
        lassign $pair sub cell
        set ref [get_property REF_NAME $cell]
        if {[regexp {^g_inv\[(\d+)\]\.u_inv$} $sub -> ii]} {
            set sl [expr {$yb + $ii / 4}]
            set be [lindex $bels [expr {$ii % 4}]]
            set_property LOC "SLICE_X${col}Y$sl" $cell
            set_property BEL $be $cell
            incr nloc
        } elseif {$ref eq "LUT2"} {
            set gatecell $cell
        } elseif {[string match "FD*" $ref]} {
            set ffcell $cell
        } elseif {$ref eq "LUT1"} {
            lappend helpers [list $sub $cell]
        }
    }
    if {$gatecell eq "" || $ffcell eq ""} { error "HARDMACRO: RO $k gate/ff not found" }
    # row 8: 门 A6, 辅助反相器 B6/C6
    set_property LOC "SLICE_X${col}Y[expr {$yb + 8}]" $gatecell
    set_property BEL A6LUT $gatecell
    incr nloc
    set hbels {B6LUT C6LUT}
    set hi 0
    foreach pair [lsort -unique $helpers] {
        lassign $pair sub cell
        if {$hi >= 2} { break }
        set_property LOC "SLICE_X${col}Y[expr {$yb + 8}]" $cell
        set_property BEL [lindex $hbels $hi] $cell
        incr nloc
        incr hi
    }
    # row 9: 采样 TFF
    set_property LOC "SLICE_X${col}Y[expr {$yb + 9}]" $ffcell
    set_property BEL AFF $ffcell
    incr nloc
}
puts ">> HARDMACRO: LOC/BEL assigned = $nloc cells (expect 256*35=8960)"

# ---- 4) 合入真实 IP ----
read_checkpoint -cell u_jtag $jceldcp
read_checkpoint -cell u_ps   $ps7dcp

# ---- 5) 实现 ----
opt_design -debug_log
place_design
route_design
report_timing_summary -file $root/logs/timing.rpt
report_utilization    -file $root/logs/util.rpt

# ---- 6) 实现后复检: 折叠可能发生在 opt/place 阶段 ----
set invs_p [get_cells -hier -quiet -filter {NAME =~ *g_inst*u_ro*g_inv* && REF_NAME == LUT1}]
puts ">> ROPUF_POSTIMPL: inverter LUT1 = [llength $invs_p] (expect 8192)"
if {[llength $invs_p] != 8192} { error "ROPUF GATE FAIL: post-impl LUT1 [llength $invs_p] != 8192" }

# ---- 7) 位流 ----
write_checkpoint -force $root/pr_out/ropuf_impl.dcp
write_bitstream -force $root/pr_out/ropuf_ax7020.bit
set bit $root/pr_out/ropuf_ax7020.bit
if {![file exists $bit]} { error "bitstream missing: $bit" }
puts ">> BIT=$bit"
puts ">> BUILD_DONE"
