# build_brpuf.tcl — 双稳环 Strong PUF (v8.0) AX7020 位流构建
#   64 级环: 1 个 LUT3 门 (u_gate, INIT 6F) + 63 个 LUT2 级 (u_ps, INIT 6),
#   硬宏单列堆叠 + 逐级交替 BEL (抵消 A6/B6 布线不对称, SRAM 单元上已验证);
#   环 = 组合环路 -> LUTLP 降级 + 环路豁免。
set root [file normalize [file join [file dirname [info script]] ..]]
puts ">> ROOT = $root"

if {[llength [glob -nocomplain $root/pr_out/ip_pr.gen/sources_1/ip/*/*.dcp]] > 0} {
    puts ">> IP_REUSE: IP dcps already exist"
} else {
    error "IP dcps missing - run a previous build first"
}

set jceldcp [lindex [concat \
  [glob -nocomplain $root/pr_out/ip_pr.gen/sources_1/ip/jtag_axi/jtag_axi.dcp] \
  [glob -nocomplain $root/pr_out/ip_pr.srcs/sources_1/ips/jtag_axi/jtag_axi.dcp]] 0]
if {$jceldcp eq ""} { error "jtag_axi OOC dcp not found" }
set ps7dcp [lindex [glob -nocomplain $root/pr_out/ip_pr.gen/sources_1/ip/ps7_0/ps7_0.dcp] 0]
if {$ps7dcp eq ""} { error "ps7_0 OOC dcp not found" }
set ps7stub [lindex [glob -nocomplain $root/pr_out/ip_pr.gen/sources_1/ip/ps7_0/*stub*.v] 0]
if {$ps7stub eq ""} { error "ps7_0 stub not found" }

set f [open $root/scripts/pins.xdc w]
puts $f "# auto-generated by build_brpuf.tcl"
puts $f "create_clock -period 10.000 -name sys_clk \[get_pins u_ps/FCLK_CLK0\]"
close $f

read_verilog [list \
  $root/rtl/br_ring.v \
  $root/rtl/brpuf_axi.v \
  $root/rtl/brpuf_eval_top.v \
  $root/scripts/jtag_axi_stub.v \
  $ps7stub ]
read_xdc $root/scripts/pins.xdc
synth_design -top brpuf_eval_top -part xc7z020clg400-1

# ---- 结构闸门 ----
set l3s  [get_cells -hier -quiet -filter {NAME =~ "*u_ring*g_stage*" && REF_NAME == LUT3}]
set rnets [get_nets -hierarchical -quiet -filter {NAME =~ "*u_ring/n*"}]
puts ">> BRPUF_CHECK: stage LUT3 = [llength $l3s] (expect 64)"
puts ">> BRPUF_CHECK: ring nets = [llength $rnets] (expect 64)"
if {[llength $l3s] != 64}   { error "BRPUF GATE FAIL: LUT3 [llength $l3s] != 64" }
if {[llength $rnets] < 64}  { error "BRPUF GATE FAIL: ring nets [llength $rnets] < 64" }
foreach c $l3s {
    set ini [get_property INIT $c]
    if {![string match -nocase "*60" $ini]} {
        error "BRPUF GATE FAIL: INIT of [get_property NAME $c] = $ini (expect 60)"
    }
}
puts ">> BRPUF_CHECK: INIT all 0x60 OK (64 LUT3)"

# ---- 硬宏: 单列 X84, Y40 = 门, Y41..Y103 = 63 级, 逐槽交替 BEL ----
set col 84
set y0  40
array set stg {}
foreach c [get_cells -hier -quiet -filter {NAME =~ "*u_ring*g_stage*" && REF_NAME == LUT3}] {
    set nm [get_property NAME $c]
    if {![regexp {g_stage\[(\d+)\]\.u_ps$} $nm -> si]} { continue }
    set stg($si) $c
}
if {[array size stg] != 64} { error "BRPUF PLACE: parsed [array size stg] != 64" }
for {set i 0} {$i <= 63} {incr i} {
    set y [expr {$y0 + $i}]
    # 交替 BEL: 槽奇偶决定 A6/B6, 抵消逐级系统偏差 (SRAM 单元同款手法)
    if {[expr {($y0 + $i) % 2}] == 0} { set be A6LUT } else { set be B6LUT }
    set_property LOC "SLICE_X${col}Y$y" $stg($i); set_property BEL $be $stg($i)
}
puts ">> BRPUF_PLACE_OK ring locked to X${col} Y${y0}..[expr {$y0+63}] (alternating BEL)"

catch { set_property SEVERITY {Warning} [get_drc_checks LUTLP-1] } e1
set_property ALLOW_COMBINATORIAL_LOOPS TRUE $rnets
puts ">> ALLOW_COMBINATORIAL_LOOPS set on [llength $rnets] nets"

read_checkpoint -cell u_jtag $jceldcp
read_checkpoint -cell u_ps   $ps7dcp

opt_design
place_design
route_design
report_timing_summary -file $root/logs/timing.rpt
report_utilization    -file $root/logs/util.rpt

set l3p [get_cells -hier -quiet -filter {NAME =~ "*u_ring*g_stage*" && REF_NAME == LUT3}]
puts ">> BRPUF_POSTIMPL: LUT3 = [llength $l3p] (expect 64)"
if {[llength $l3p] != 64} { error "BRPUF GATE FAIL: post-impl [llength $l3p] != 64" }

write_checkpoint -force $root/pr_out/brpuf_impl.dcp
write_bitstream -force $root/pr_out/brpuf_ax7020.bit
set bit $root/pr_out/brpuf_ax7020.bit
if {![file exists $bit]} { error "bitstream missing: $bit" }
puts ">> BIT=$bit"
puts ">> BUILD_DONE"
