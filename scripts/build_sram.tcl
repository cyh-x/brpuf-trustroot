# build_sram.tcl — 锁存型 SRAM-类 PUF (v7.0) AX7020 位流构建
#   256 单元, 每单元一个 slice (u_la A6LUT / u_lb B6LUT 交叉耦合);
#   交叉耦合 = 组合环路 -> LUTLP 降级 + 环路豁免。
set root [file normalize [file join [file dirname [info script]] ..]]
puts ">> ROOT = $root"

if {[llength [glob -nocomplain $root/pr_out/ip_pr.gen/sources_1/ip/*/*.dcp]] > 0} {
    puts ">> IP_REUSE: IP dcps already exist"
} else {
    create_project ip_pr $root/pr_out -part xc7z020clg400-1 -force
    create_ip -name jtag_axi -vendor xilinx.com -library ip -module_name jtag_axi
    create_ip -name processing_system7 -vendor xilinx.com -library ip -module_name ps7_0
    foreach {k v} {
        CONFIG.PCW_FPGA0_PERIPHERAL_FREQMHZ  100
        CONFIG.PCW_FCLK_CLK0_BUF             TRUE
        CONFIG.PCW_EN_CLK0_PORT              1
        CONFIG.PCW_USE_M_AXI_GP0             0
    } {
        if {[catch { set_property -name $k -value $v -objects [get_ips ps7_0] } e]} {
            puts ">> PS7_SET_WARN $k=$v : $e"
        } else { puts ">> PS7_SET_OK   $k=$v" }
    }
    generate_target all [get_ips jtag_axi]
    generate_target all [get_ips ps7_0]
    synth_ip [get_ips jtag_axi]
    synth_ip [get_ips ps7_0]
    close_project
}

set jceldcp [lindex [concat \
  [glob -nocomplain $root/pr_out/ip_pr.gen/sources_1/ip/jtag_axi/jtag_axi.dcp] \
  [glob -nocomplain $root/pr_out/ip_pr.srcs/sources_1/ips/jtag_axi/jtag_axi.dcp]] 0]
if {$jceldcp eq ""} { error "jtag_axi OOC dcp not found" }
set ps7dcp [lindex [glob -nocomplain $root/pr_out/ip_pr.gen/sources_1/ip/ps7_0/ps7_0.dcp] 0]
if {$ps7dcp eq ""} { error "ps7_0 OOC dcp not found" }
set ps7stub [lindex [glob -nocomplain $root/pr_out/ip_pr.gen/sources_1/ip/ps7_0/*stub*.v] 0]
if {$ps7stub eq ""} { error "ps7_0 stub not found" }

set f [open $root/scripts/pins.xdc w]
puts $f "# auto-generated by build_sram.tcl"
puts $f "create_clock -period 10.000 -name sys_clk \[get_pins u_ps/FCLK_CLK0\]"
close $f

read_verilog [list \
  $root/rtl/sram_axi.v \
  $root/rtl/sram_eval_top.v \
  $root/scripts/jtag_axi_stub.v \
  $ps7stub ]
read_xdc $root/scripts/pins.xdc
synth_design -top sram_eval_top -part xc7z020clg400-1

# ---- 结构闸门 ----
set las [get_cells -hier -quiet -filter {NAME =~ *g_cell*u_la && REF_NAME == LUT2}]
set lbs [get_cells -hier -quiet -filter {NAME =~ *g_cell*u_lb && REF_NAME == LUT2}]
puts ">> SRAM_CHECK: cells = [llength $las]/[llength $lbs] (expect 256/256)"
if {[llength $las] != 256 || [llength $lbs] != 256} {
    error "SRAM GATE FAIL: cells [llength $las]/[llength $lbs] != 256/256"
}
foreach c [concat $las $lbs] {
    set ini [get_property INIT $c]
    if {![string match -nocase "*7" $ini]} {
        error "SRAM GATE FAIL: INIT of [get_property NAME $c] = $ini"
    }
}
puts ">> SRAM_CHECK: INIT all 4'h7 OK (512 LUT2)"

# ---- 硬宏: 每单元一个 slice, 64 列 x 4 层, 从真实 site 推槽位 ----
set sites_all [get_sites -quiet -filter {SITE_TYPE == "SLICEL" || SITE_TYPE == "SLICEM"}]
array set colrows {}
foreach s $sites_all {
    if {[regexp {SLICE_X(\d+)Y(\d+)} [get_property NAME $s] -> x y]} { lappend colrows($x) $y }
}
set slots {}
foreach b {1 51 101} {
    set ok {}
    foreach x [lsort -integer [array names colrows]] {
        if {[lsearch -integer $colrows($x) $b] >= 0} { lappend ok $x }
    }
    set n [llength $ok]
    if {$n % 2 == 1} { incr n -1 }
    for {set i 0} {$i < $n} {incr i} { lappend slots [list [lindex $ok $i] $b] }
}
puts ">> SRAM slots = [llength $slots] (need 256)"
if {[llength $slots] < 256} { error "SRAM PLACE: only [llength $slots] slots" }
set use [lrange $slots 0 255]

array set cella {}
foreach c [get_cells -hier -quiet -filter {NAME =~ *g_cell*u_la || NAME =~ *g_cell*u_lb}] {
    set nm [get_property NAME $c]
    if {![regexp {g_cell\[(\d+)\]\.(u_la|u_lb)$} $nm -> ci which]} { continue }
    set cella($ci,$which) $c
}
if {[array size cella] != 512} { error "SRAM PLACE: parsed [array size cella] cells != 512" }
# 奇偶单元交替 BEL (v7.1): A6/B6 布局不对称把竞争方向写死 (实测均匀性 88-90%),
# 奇数单元交换 u_la/u_lb 的 BEL -> 偏置方向交替; 分析时相邻单元异或 -> 偏置抵消
for {set k 0} {$k < 256} {incr k} {
    lassign [lindex $use $k] col y
    if {$k % 2 == 0} {
        set_property LOC "SLICE_X${col}Y$y" $cella($k,u_la); set_property BEL A6LUT $cella($k,u_la)
        set_property LOC "SLICE_X${col}Y$y" $cella($k,u_lb); set_property BEL B6LUT $cella($k,u_lb)
    } else {
        set_property LOC "SLICE_X${col}Y$y" $cella($k,u_la); set_property BEL B6LUT $cella($k,u_la)
        set_property LOC "SLICE_X${col}Y$y" $cella($k,u_lb); set_property BEL A6LUT $cella($k,u_lb)
    }
}
puts ">> SRAM_PLACE_OK 256 cells locked"

# 环路豁免
catch { set_property SEVERITY {Warning} [get_drc_checks LUTLP-1] } e1
set loopnets [get_nets -hierarchical -quiet -filter {NAME =~ "*u_spuf/na*" || NAME =~ "*u_spuf/nb*"}]
puts ">> SRAM loop nets = [llength $loopnets]"
if {[llength $loopnets] > 0} {
    set_property ALLOW_COMBINATORIAL_LOOPS TRUE $loopnets
} else {
    puts ">> SRAM_LOOP_WARN: no loop nets matched"
}
puts ">> ALLOW_COMBINATORIAL_LOOPS set on [llength $loopnets] nets"

read_checkpoint -cell u_jtag $jceldcp
read_checkpoint -cell u_ps   $ps7dcp

opt_design
place_design
route_design
report_timing_summary -file $root/logs/timing.rpt
report_utilization    -file $root/logs/util.rpt

set las_p [get_cells -hier -quiet -filter {NAME =~ *g_cell*u_la && REF_NAME == LUT2}]
puts ">> SRAM_POSTIMPL: cells = [llength $las_p] (expect 256)"
if {[llength $las_p] != 256} { error "SRAM GATE FAIL: post-impl [llength $las_p] != 256" }

write_checkpoint -force $root/pr_out/sram_impl.dcp
write_bitstream -force $root/pr_out/sram_ax7020.bit
set bit $root/pr_out/sram_ax7020.bit
if {![file exists $bit]} { error "bitstream missing: $bit" }
puts ">> BIT=$bit"
puts ">> BUILD_DONE"
