# build_brpuf2.tcl — 双稳环阵列 Strong PUF (v9.0) AX7020 位流构建
#   64 环 x 16 级, 每环独占一列 (v8 单环 0.78% 唯一性的修复: 列间布线多样性)。
set root [file normalize [file join [file dirname [info script]] ..]]
puts ">> ROOT = $root"

if {[llength [glob -nocomplain $root/pr_out/ip_pr.gen/sources_1/ip/*/*.dcp]] == 0} {
    error "IP dcps missing - run a previous build first"
}
set jceldcp [lindex [concat \
  [glob -nocomplain $root/pr_out/ip_pr.gen/sources_1/ip/jtag_axi/jtag_axi.dcp] \
  [glob -nocomplain $root/pr_out/ip_pr.srcs/sources_1/ips/jtag_axi/jtag_axi.dcp]] 0]
set ps7dcp [lindex [glob -nocomplain $root/pr_out/ip_pr.gen/sources_1/ip/ps7_0/ps7_0.dcp] 0]
set ps7stub [lindex [glob -nocomplain $root/pr_out/ip_pr.gen/sources_1/ip/ps7_0/*stub*.v] 0]

set f [open $root/scripts/pins.xdc w]
puts $f "# auto-generated by build_brpuf2.tcl"
puts $f "create_clock -period 10.000 -name sys_clk \[get_pins u_ps/FCLK_CLK0\]"
close $f

read_verilog [list \
  $root/rtl/br_ring16.v \
  $root/rtl/brpuf2_axi.v \
  $root/rtl/brpuf2_eval_top.v \
  $root/scripts/jtag_axi_stub.v \
  $ps7stub ]
read_xdc $root/scripts/pins.xdc
synth_design -top brpuf2_eval_top -part xc7z020clg400-1

# ---- 结构闸门: 64 环 x 16 级 LUT3 (INIT 60) ----
set l3s [get_cells -hier -quiet -filter {NAME =~ "*g_ring*u_ring*g_stage*u_ps" && REF_NAME == LUT3}]
puts ">> BRPUF2_CHECK: stage LUT3 = [llength $l3s] (expect 1024)"
if {[llength $l3s] != 1024} { error "BRPUF2 GATE FAIL: [llength $l3s] != 1024" }
foreach c [lrange $l3s 0 7] {
    set ini [get_property INIT $c]
    if {![string match -nocase "*60" $ini]} { error "BRPUF2 GATE FAIL: INIT $ini" }
}
puts ">> BRPUF2_CHECK: INIT 0x60 OK"

# ---- 硬宏: 每环一列 (Y1..Y16 带), 从真实 site 推槽位 ----
set sites_all [get_sites -quiet -filter {SITE_TYPE == "SLICEL" || SITE_TYPE == "SLICEM"}]
array set colrows {}
foreach s $sites_all {
    if {[regexp {SLICE_X(\d+)Y(\d+)} [get_property NAME $s] -> x y]} { lappend colrows($x) $y }
}
set slots {}
foreach b {1 51 101} {
    set ok {}
    foreach x [lsort -integer [array names colrows]] {
        set good 1
        for {set d 0} {$d < 16} {incr d} {
            if {[lsearch -integer $colrows($x) [expr {$b+$d}]] < 0} { set good 0; break }
        }
        if {$good} { lappend ok $x }
    }
    foreach x $ok { lappend slots [list $x $b] }
}
puts ">> BRPUF2 slots = [llength $slots] (need 64)"
if {[llength $slots] < 64} { error "BRPUF2 PLACE: only [llength $slots] slots" }
set use [lrange $slots 0 63]

# 解析每环的 16 个级单元
array set ringcells {}
foreach c $l3s {
    set nm [get_property NAME $c]
    if {![regexp {g_ring\[(\d+)\]\.u_ring/g_stage\[(\d+)\]\.u_ps$} $nm -> rk si]} { continue }
    lappend ringcells($rk) [list $si $c]
}
puts ">> BRPUF2 rings parsed = [array size ringcells] (expect 64)"
if {[array size ringcells] != 64} { error "BRPUF2 PLACE: [array size ringcells] != 64" }

set nloc 0
for {set k 0} {$k < 64} {incr k} {
    lassign [lindex $use $k] col yb
    foreach pair $ringcells($k) {
        lassign $pair si cell
        set y [expr {$yb + $si}]
        set be [expr {$si % 2 == 0 ? "A6LUT" : "B6LUT"}]
        set_property LOC "SLICE_X${col}Y$y" $cell
        set_property BEL $be $cell
        incr nloc
    }
}
puts ">> BRPUF2_PLACE_OK $nloc LUT3 locked (64 rings, one column each)"

# 环路豁免
catch { set_property SEVERITY {Warning} [get_drc_checks LUTLP-1] } e1
set loopnets [get_nets -hierarchical -quiet -filter {NAME =~ "*g_ring*u_ring*n*"}]
puts ">> BRPUF2 loop nets = [llength $loopnets] (expect 1024+)"
if {[llength $loopnets] > 0} {
    set_property ALLOW_COMBINATORIAL_LOOPS TRUE $loopnets
} else { error "BRPUF2 GATE FAIL: no ring nets found" }

read_checkpoint -cell u_jtag $jceldcp
read_checkpoint -cell u_ps   $ps7dcp

opt_design
place_design
route_design
report_timing_summary -file $root/logs/timing.rpt
report_utilization    -file $root/logs/util.rpt

set l3p [get_cells -hier -quiet -filter {NAME =~ "*g_ring*u_ring*g_stage*u_ps" && REF_NAME == LUT3}]
puts ">> BRPUF2_POSTIMPL: LUT3 = [llength $l3p] (expect 1024)"
if {[llength $l3p] != 1024} { error "BRPUF2 GATE FAIL: post-impl [llength $l3p] != 1024" }

write_checkpoint -force $root/pr_out/brpuf2_impl.dcp
write_bitstream -force $root/pr_out/brpuf2_ax7020.bit
if {![file exists $root/pr_out/brpuf2_ax7020.bit]} { error "bitstream missing" }
puts ">> BIT=$root/pr_out/brpuf2_ax7020.bit"
puts ">> BUILD_DONE"
