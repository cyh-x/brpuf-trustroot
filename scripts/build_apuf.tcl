# build_apuf.tcl — PDL 仲裁 PUF (v5.0) AX7020 位流构建
#   布局: 双链逐级锁进同一列连续 slice —— 级 i 的上/下 LUT6 在同一 slice 的
#   A6LUT/B6LUT (上下路径几何镜像), 66 级垂直堆叠 + 启动/仲裁 FF 独占 slice。
#   用法: vivado.bat -mode batch -source scripts/build_apuf.tcl
set root [file normalize [file join [file dirname [info script]] ..]]
puts ">> ROOT = $root"

# ---- 0) IP (已存在则复用) ----
if {[llength [glob -nocomplain $root/pr_out/ip_pr.gen/sources_1/ip/*/*.dcp]] > 0} {
    puts ">> IP_REUSE: IP dcps already exist"
} else {
    create_project ip_pr $root/pr_out -part xc7z020clg400-1 -force
    create_ip -name jtag_axi -vendor xilinx.com -library ip -module_name jtag_axi
    create_ip -name processing_system7 -vendor xilinx.com -library ip -module_name ps7_0
    foreach {k v} {
        CONFIG.PCW_FPGA0_PERIPHERAL_FREQMHZ  100
        CONFIG.PCW_FCLK_CLK0_BUF             TRUE
        CONFIG.PCW_EN_CLK0_PORT              1
        CONFIG.PCW_USE_M_AXI_GP0             0
    } {
        if {[catch { set_property -name $k -value $v -objects [get_ips ps7_0] } e]} {
            puts ">> PS7_SET_WARN $k=$v : $e"
        } else { puts ">> PS7_SET_OK   $k=$v" }
    }
    generate_target all [get_ips jtag_axi]
    generate_target all [get_ips ps7_0]
    synth_ip [get_ips jtag_axi]
    synth_ip [get_ips ps7_0]
    close_project
}

set jceldcp [lindex [concat \
  [glob -nocomplain $root/pr_out/ip_pr.gen/sources_1/ip/jtag_axi/jtag_axi.dcp] \
  [glob -nocomplain $root/pr_out/ip_pr.srcs/sources_1/ips/jtag_axi/jtag_axi.dcp]] 0]
if {$jceldcp eq ""} { error "jtag_axi OOC dcp not found" }
set ps7dcp [lindex [glob -nocomplain $root/pr_out/ip_pr.gen/sources_1/ip/ps7_0/ps7_0.dcp] 0]
if {$ps7dcp eq ""} { error "ps7_0 OOC dcp not found" }
set ps7stub [lindex [glob -nocomplain $root/pr_out/ip_pr.gen/sources_1/ip/ps7_0/*stub*.v] 0]
if {$ps7stub eq ""} { error "ps7_0 stub not found" }
puts ">> IP DCP: jtag_axi=$jceldcp  ps7_0=$ps7dcp"

# ---- 1) XDC ----
set f [open $root/scripts/pins.xdc w]
puts $f "# auto-generated by build_apuf.tcl (PS7 FCLK_CLK0=100MHz)"
puts $f "create_clock -period 10.000 -name sys_clk \[get_pins u_ps/FCLK_CLK0\]"
close $f

# ---- 2) RTL + 综合 ----
read_verilog [list \
  $root/rtl/apuf_axi.v \
  $root/rtl/apuf_eval_top.v \
  $root/scripts/jtag_axi_stub.v \
  $ps7stub ]
read_xdc $root/scripts/pins.xdc
synth_design -top apuf_eval_top -part xc7z020clg400-1

# ---- 3) 结构闸门 ----
set lut6s [get_cells -hier -quiet -filter {NAME =~ *u_spuf*g_stage*u_* && REF_NAME == LUT6}]
set tunes [get_cells -hier -quiet -filter {NAME =~ "*u_spuf/u_tt" || NAME =~ "*u_spuf/u_bt"}]
set fins  [get_cells -hier -quiet -filter {NAME =~ "*u_spuf/u_tf" || NAME =~ "*u_spuf/u_bf"}]
set lff   [get_cells -hier -quiet -filter {NAME =~ *u_spuf*u_launch* && REF_NAME =~ FD*}]
set aff   [get_cells -hier -quiet -filter {NAME =~ *u_spuf*u_arb* && REF_NAME =~ FD*}]
puts ">> APUF_CHECK: stage LUT6 = [llength $lut6s] (expect 128 = 64x2)"
puts ">> APUF_CHECK: tune  LUT6 = [llength $tunes] (expect 2)"
puts ">> APUF_CHECK: fin   LUT6 = [llength $fins]  (expect 2)"
puts ">> APUF_CHECK: launch/arb FF = [llength $lff]/[llength $aff] (expect 1/1)"
if {[llength $lut6s] != 128} { error "APUF GATE FAIL: stage LUT6 [llength $lut6s] != 128" }
if {[llength $tunes] != 2}   { error "APUF GATE FAIL: tune LUT6 [llength $tunes] != 2" }
if {[llength $fins] != 2}    { error "APUF GATE FAIL: fin LUT6 [llength $fins] != 2" }
if {[llength $lff] != 1}     { error "APUF GATE FAIL: launch FF [llength $lff] != 1" }
if {[llength $aff] != 1}     { error "APUF GATE FAIL: arb FF [llength $aff] != 1" }
# INIT 抽查: 必须是 0xAAAA... (O=~I0, I1-I5 路径控制)
foreach c [concat $lut6s $tunes $fins] {
    set ini [get_property INIT $c]
    if {![string match -nocase "*5555555555555555" $ini]} {
        error "APUF GATE FAIL: INIT of [get_property NAME $c] = $ini (expect AAAAA...)"
    }
}
puts ">> APUF_CHECK: INIT all 0x5555..5555 OK (132 LUT6)"

# ---- 3b) 硬宏: 单列垂直堆叠, 级 i 同 slice A6(上链)/B6(下链) ----
#   列选 X70, y0=20:  slice Y20 = launch FF (AFF)
#                     Y21 = tune 级 (u_tt A6 / u_bt B6)
#                     Y22..Y85 = 64 挑战级 (g_stage[i]: u_ts A6 / u_bs B6)
#                     Y86 = 收尾级 (u_tf A6 / u_bf B6)
#                     Y87 = 仲裁 FF (AFF, 独占 slice: 7 系列同 slice 4 FF 共享 CLK)
set col 84
set y0   40
set tt [get_cells -hier -quiet -filter {NAME =~ *u_spuf*u_tt}]
set tb [get_cells -hier -quiet -filter {NAME =~ *u_spuf*u_bt}]
set tf [get_cells -hier -quiet -filter {NAME =~ *u_spuf*u_tf}]
set bf [get_cells -hier -quiet -filter {NAME =~ *u_spuf*u_bf}]
# BEL 交替 (关键): A6/B6 的垂直走线资源系统性不对称 (实测上链慢 3.0ns = 45ps/级),
# 逐槽交替 top/bottom 的 BEL 让每级偏差成对抵消。槽 0=tune(Y40) 1..64=stage 65=fin(Y105)
proc slot_bels {s} {
    if {$s % 2 == 0} { return {A6LUT B6LUT} } else { return {B6LUT A6LUT} }
}
lassign [slot_bels 0] bt_t bt_b
set_property LOC "SLICE_X${col}Y$y0"      [lindex $tt 0]; set_property BEL $bt_t [lindex $tt 0]
set_property LOC "SLICE_X${col}Y$y0"      [lindex $tb 0]; set_property BEL $bt_b [lindex $tb 0]
lassign [slot_bels 65] bf_t bf_b
set_property LOC "SLICE_X${col}Y[expr {$y0+65}]" [lindex $tf 0]; set_property BEL $bf_t [lindex $tf 0]
set_property LOC "SLICE_X${col}Y[expr {$y0+65}]" [lindex $bf 0]; set_property BEL $bf_b [lindex $bf 0]
set nloc 4
# 一次性收集全部级单元再按名称解析索引 (逐名查询的 glob 方括号转义不可靠)
array set stg {}
foreach c [get_cells -hier -quiet -filter {NAME =~ *u_spuf*g_stage*u_* && REF_NAME == LUT6}] {
    set nm [get_property NAME $c]
    if {![regexp {g_stage\[(\d+)\]\.(u_ts|u_bs)$} $nm -> si which]} { continue }
    set stg($si,$which) $c
}
for {set i 0} {$i < 64} {incr i} {
    if {![info exists stg($i,u_ts)] || ![info exists stg($i,u_bs)]} {
        error "APUF PLACE: stage $i not found ([array size stg] parsed)"
    }
    set y [expr {$y0 + 1 + $i}]
    lassign [slot_bels [expr {$i + 1}]] bs_t bs_b
    set_property LOC "SLICE_X${col}Y$y" $stg($i,u_ts); set_property BEL $bs_t $stg($i,u_ts)
    set_property LOC "SLICE_X${col}Y$y" $stg($i,u_bs); set_property BEL $bs_b $stg($i,u_bs)
    incr nloc 2
}
set lf [lindex [get_cells -hier -quiet -filter {NAME =~ *u_spuf*u_launch*}] 0]
set af [lindex [get_cells -hier -quiet -filter {NAME =~ *u_spuf*u_arb*}] 0]
set_property LOC "SLICE_X${col}Y[expr {$y0-1}]"  $lf; set_property BEL AFF $lf
set_property LOC "SLICE_X${col}Y[expr {$y0+66}]" $af; set_property BEL AFF $af
puts ">> APUF_PLACE_OK $nloc stage LUTs locked to column X${col} Y${y0}..[expr {$y0+65}], FF at Y[expr {$y0-1}]/Y[expr {$y0+66}]"

# ---- 4) 合入真实 IP ----
read_checkpoint -cell u_jtag $jceldcp
read_checkpoint -cell u_ps   $ps7dcp

# ---- 5) 实现 ----
opt_design
place_design
route_design
report_timing_summary -file $root/logs/timing.rpt
report_utilization    -file $root/logs/util.rpt

# ---- 6) 实现后复检 ----
set lut6s_p [get_cells -hier -quiet -filter {NAME =~ *u_spuf*g_stage*u_* && REF_NAME == LUT6}]
puts ">> APUF_POSTIMPL: stage LUT6 = [llength $lut6s_p] (expect 128)"
if {[llength $lut6s_p] != 128} { error "APUF GATE FAIL: post-impl [llength $lut6s_p] != 128" }

# ---- 7) 位流 ----
write_checkpoint -force $root/pr_out/apuf_impl.dcp
write_bitstream -force $root/pr_out/apuf_ax7020.bit
set bit $root/pr_out/apuf_ax7020.bit
if {![file exists $bit]} { error "bitstream missing: $bit" }
puts ">> BIT=$bit"
puts ">> BUILD_DONE"
