# build_bit.tcl — Strong PUF (4x4 APUF) AX7020 位流构建 (非项目流)
#   骨架复用 ax7020_port/dsp_glitch_puf 已验证流程; 工作区必须是纯 ASCII 路径
#   平台: ALINX AX7020 = xc7z020clg400-1, Vivado 2026.1, FCLK_CLK0=100MHz
# 用法: vivado.bat -mode batch -source scripts/build_bit.tcl  (经 build_ascii.sh 调用)
#
# 布局策略 (仿上游 placement/manual_placement.xdc, 按本工程层级名动态生成):
#   每级开关块的 4 个路径 mux 钉进同一 slice 的 D6/C6/B6/A6 LUT,
#   24 级在同一列垂直相邻堆叠 -> 4 条路径逐级同 tile 对称, 抵消布线系统性偏差。

set root [file normalize [file join [file dirname [info script]] ..]]
puts ">> ROOT = $root"

# ---- 0) IP (与 ax7020_port 相同; 已存在则复用) ----
if {[llength [glob -nocomplain $root/pr_out/ip_pr.gen/sources_1/ip/*/*.dcp]] > 0} {
    puts ">> IP_REUSE: IP dcps already exist"
} else {
    create_project ip_pr $root/pr_out -part xc7z020clg400-1 -force
    create_ip -name jtag_axi -vendor xilinx.com -library ip -module_name jtag_axi
    create_ip -name processing_system7 -vendor xilinx.com -library ip -module_name ps7_0
    foreach {k v} {
        CONFIG.PCW_FPGA0_PERIPHERAL_FREQMHZ  100
        CONFIG.PCW_FCLK_CLK0_BUF             TRUE
        CONFIG.PCW_EN_CLK0_PORT              1
        CONFIG.PCW_USE_M_AXI_GP0             0
    } {
        if {[catch { set_property -name $k -value $v -objects [get_ips ps7_0] } e]} {
            puts ">> PS7_SET_WARN $k=$v : $e"
        } else { puts ">> PS7_SET_OK   $k=$v" }
    }
    generate_target all [get_ips jtag_axi]
    generate_target all [get_ips ps7_0]
    synth_ip [get_ips jtag_axi]
    synth_ip [get_ips ps7_0]
    close_project
}

set jceldcp [lindex [concat \
  [glob -nocomplain $root/pr_out/ip_pr.gen/sources_1/ip/jtag_axi/jtag_axi.dcp] \
  [glob -nocomplain $root/pr_out/ip_pr.srcs/sources_1/ips/jtag_axi/jtag_axi.dcp]] 0]
if {$jceldcp eq ""} { error "jtag_axi OOC dcp not found" }
set ps7dcp [lindex [glob -nocomplain $root/pr_out/ip_pr.gen/sources_1/ip/ps7_0/ps7_0.dcp] 0]
if {$ps7dcp eq ""} { error "ps7_0 OOC dcp not found" }
set ps7stub [lindex [glob -nocomplain $root/pr_out/ip_pr.gen/sources_1/ip/ps7_0/*stub*.v] 0]
if {$ps7stub eq ""} { error "ps7_0 stub not found" }
puts ">> IP DCP: jtag_axi=$jceldcp  ps7_0=$ps7dcp"

# ---- 1) XDC (只放时钟; 平铺命令, 不写 catch/if) ----
set f [open $root/scripts/pins.xdc w]
puts $f "# auto-generated by build_bit.tcl (PS7 FCLK_CLK0=100MHz)"
puts $f "create_clock -period 10.000 -name sys_clk \[get_pins u_ps/FCLK_CLK0\]"
close $f

# ---- 2) RTL + 综合 (jtag_axi/ps7 黑盒; VHDL+Verilog 混合) ----
read_verilog [list \
  $root/rtl/ropuf_axi.v \
  $root/rtl/ropuf_eval_top.v \
  $root/scripts/jtag_axi_stub.v \
  $ps7stub ]
read_vhdl [list \
  $root/rtl/ring_oscillator_kept.vhd \
  $root/rtl/ro_cell.vhd ]
read_xdc $root/scripts/pins.xdc
synth_design -top spuf_eval_top -part xc7z020clg400-1

# ---- 3) 结构核查闸门 ----
#   RO 存活的硬证据 = 256 个 TFF 采样 FF (TFF 仅存在于 RO 内部, RO 被合并则 TFF 同被合并)
#   + 256 个组合环路 net (每 RO 环至少 1 条)。u_ro 名下的 LUT 计数仅打印参考
#   (会混入相邻 g_ro 计数器进位逻辑, 2026-10-29 实测 5888=256x23, 不作闸门)
set muxes [get_cells -hier -quiet -filter {NAME =~ *u_apuf*EQUAL_PATH_MUX* && REF_NAME =~ LUT*}]
set rffs  [get_cells -hier -quiet -filter {NAME =~ *u_apuf*APUF_ARBITER/FF_* && REF_NAME =~ FD*}]
puts ">> SPUF_CHECK: path-mux LUTs = [llength $muxes] (expect 384 = 4 inst x 96)"
puts ">> SPUF_CHECK: race FFs      = [llength $rffs] (expect 24 = 4 inst x 6)"
if {[llength $muxes] != 384} { error "SPUF GATE FAIL: mux LUTs [llength $muxes] != 384" }
if {[llength $rffs] != 24}   { error "SPUF GATE FAIL: race FFs [llength $rffs] != 24" }

# ---- 3b) 4-XOR 对称布局: 每实例 24 级各占一列 (X66/X70/X74/X78), 每级 4 mux 同 slice
#   实例名 u_apuf0..u_apuf3 -> 列 X66/X70/X74/X78 (相隔 4 列, 布局环境独立)
set bels [list D6LUT C6LUT B6LUT A6LUT]
set cols [list 66 70 74 78]
set n_placed 0
foreach c $muxes {
    set nm [get_property NAME $c]
    set inst -1
    if {[string match "*u_apuf0*" $nm]} { set inst 0 }
    if {[string match "*u_apuf1*" $nm]} { set inst 1 }
    if {[string match "*u_apuf2*" $nm]} { set inst 2 }
    if {[string match "*u_apuf3*" $nm]} { set inst 3 }
    if {$inst < 0} { error "SPUF PLACE: cannot parse instance from $nm" }
    set stage -1
    if {[string match "*FIRST_SWITCH_BLOCK*" $nm]} { set stage 0 }
    if {[regexp {SWITCH_BLOCKS\[([0-9]+)\]} $nm -> i]} { set stage [expr {$i + 1}] }
    if {$stage < 0} { error "SPUF PLACE: cannot parse stage from $nm" }
    if {![regexp {EQUAL_PATHS\[([0-9])\]} $nm -> k]} { error "SPUF PLACE: cannot parse path idx from $nm" }
    set xc [lindex $cols $inst]
    set y  [expr {99 - $stage}]
    set_property LOC "SLICE_X${xc}Y$y" $c
    set_property BEL [lindex $bels $k] $c
    incr n_placed
}
puts ">> SPUF_PLACE_OK $n_placed/384 muxes locked (4 cols X66/70/74/78, Y99..Y76)"

# ---- 4) 合入真实 IP ----
read_checkpoint -cell u_jtag $jceldcp
read_checkpoint -cell u_ps   $ps7dcp

# ---- 5) 实现 ----
opt_design -debug_log
place_design
route_design
report_timing_summary -file $root/logs/timing.rpt
report_utilization    -file $root/logs/util.rpt

# ---- 6) 位流 ----
write_checkpoint -force $root/pr_out/spuf_impl.dcp
write_bitstream -force $root/pr_out/spuf_xor_ax7020.bit
set bit $root/pr_out/spuf_xor_ax7020.bit
if {![file exists $bit]} { error "bitstream missing: $bit" }
puts ">> BIT=$bit"
puts ">> BUILD_DONE"
