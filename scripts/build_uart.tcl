# build_uart.tcl — UART 架构信任根 (v14): PS 唯一主机, 三引擎 + 邮箱
# 工作区根目录：可用环境变量 BRPUF_WORKSPACE 覆盖（默认仓库根）
if {![info exists ws]} {
    if {[info exists ::env(BRPUF_WORKSPACE)]} {
        set ws $::env(BRPUF_WORKSPACE)
    } else {
        set ws [file normalize [file join [file dirname [info script]] ..]]
    }
}
set root [file normalize [file join [file dirname [info script]] ..]]
puts ">> ROOT = $root"

set ps7dcp $ws/ps7v14/ps7v14.gen/sources_1/ip/ps7_0/ps7_0.dcp
set ps7stub $ws/ps7v14/ps7v14.gen/sources_1/ip/ps7_0/ps7_0_stub.v
if {![file exists $ps7dcp]} { error "PS7 UART dcp missing" }

set f [open $root/scripts/pins.xdc w]
puts $f "# auto-generated by build_crypto.tcl"
puts $f "create_clock -period 15.000 -name sys_clk \[get_pins u_ps/FCLK_CLK0\]"
close $f

read_verilog [list \
  $root/rtl/br_ring16.v \
  $root/rtl/brpuf2_axi.v \
  $root/rtl/axi_lite_demux.v \
  $root/rtl/mailbox_axi.v \
  $root/rtl/trustroot_uart_top.v \
  $root/rtl/crypto/aes256_ip_v1_0.v \
  $root/rtl/crypto/aes256_ip_v1_0_S0_AXI.v \
  $root/rtl/crypto/aes256.v \
  $root/rtl/crypto/trng_v1_0.v \
  $root/rtl/crypto/trng_v1_0_S0_AXI.v \
  $root/rtl/crypto/trng_key_provider.v \
  $root/rtl/crypto/sha256.v \
  $ps7stub ]
read_vhdl [list \
  $root/rtl/crypto/neoTRNG.vhd \
  $root/rtl/crypto/trng_core.vhd ]
read_xdc $root/scripts/pins.xdc
synth_design -top trustroot_uart_top -part xc7z020clg400-1

# ---- 结构闸门 ----
set l3s [get_cells -hier -quiet -filter {NAME =~ "*u_puf*g_ring*u_ring*g_stage*" && REF_NAME == LUT3}]
puts ">> CRYPTO_CHECK: BR-PUF stage LUT3 = [llength $l3s] (expect 1024)"
if {[llength $l3s] != 1024} { error "CRYPTO GATE FAIL: BR-PUF [llength $l3s] != 1024" }
set aes_core [get_cells -hier -quiet -filter {NAME =~ "*u_aes*u_aes256*" && REF_NAME =~ "aes256*"}]
if {[llength $aes_core] == 0} {
    set aes_core [get_cells -hier -quiet -filter {NAME =~ "*u_aes*aes256_block*"}]
}
puts ">> CRYPTO_CHECK: AES core cells = [llength $aes_core]"
if {[llength $aes_core] == 0} {
    set aes_lut [llength [get_cells -hier -quiet -filter {NAME =~ "*u_aes*" && REF_NAME =~ LUT*}]]
    puts ">> CRYPTO_CHECK: AES LUTs = $aes_lut (info)"
    if {$aes_lut < 1000} { error "CRYPTO GATE FAIL: AES 逻辑过少 ($aes_lut LUT), 可能被优化掉" }
}
set trng_cells [get_cells -hier -quiet -filter {NAME =~ "*u_trng*neoTRNG*" || NAME =~ "*u_trng*u_trng_core*"}]
puts ">> CRYPTO_CHECK: TRNG cells = [llength $trng_cells]"
set trng_lut [llength [get_cells -hier -quiet -filter {NAME =~ "*u_trng*" && REF_NAME =~ LUT*}]]
puts ">> CRYPTO_CHECK: TRNG LUTs = $trng_lut"
if {$trng_lut < 50} { error "CRYPTO GATE FAIL: TRNG 逻辑过少 ($trng_lut LUT)" }
set sha_cells [get_cells -hier -quiet -filter {NAME =~ "*u_trng*sha256*"}]
puts ">> CRYPTO_CHECK: SHA256 cells = [llength $sha_cells] (0 也可能因层级合并, 仅信息)"
set mball [get_cells -hier -quiet -filter {NAME =~ "*u_mb*"}]
set mbram [get_cells -hier -quiet -filter {NAME =~ "*u_mb*" && (REF_NAME =~ RAMB* || PRIMITIVE_GROUP =~ *RAM*)}]
set mblut [llength [get_cells -hier -quiet -filter {NAME =~ "*u_mb*" && REF_NAME =~ LUT*}]]
puts ">> CRYPTO_CHECK: MAILBOX cells=[llength $mball] BRAM-like=[llength $mbram] LUTs=$mblut"
if {[llength $mbram] < 1 && $mblut < 8} { error "CRYPTO GATE FAIL: mailbox missing (cells=[llength $mball] luts=$mblut)" }
puts ">> CRYPTO_CHECK: ALL PASS"

# ---- BR-PUF 硬宏布局 (与 brpuf2 相同) ----
set col 84
set y0  40
array set stg {}
foreach c [get_cells -hier -quiet -filter {NAME =~ "*u_puf*g_ring*u_ring*g_stage*" && REF_NAME == LUT3}] {
    set nm [get_property NAME $c]
    if {![regexp {g_ring\[(\d+)\]\.u_ring/g_stage\[(\d+)\]\.u_ps$} $nm -> rk si]} { continue }
    lappend stg($rk) [list $si $c]
}
if {[array size stg] != 64} { error "CRYPTO PLACE: rings [array size stg] != 64" }
set sites_all [get_sites -quiet -filter {SITE_TYPE == "SLICEL" || SITE_TYPE == "SLICEM"}]
array set colrows {}
foreach s $sites_all {
    if {[regexp {SLICE_X(\d+)Y(\d+)} [get_property NAME $s] -> x y]} { lappend colrows($x) $y }
}
set slots {}
foreach b {1 51 101} {
    set ok {}
    foreach x [lsort -integer [array names colrows]] {
        set good 1
        for {set d 0} {$d < 16} {incr d} {
            if {[lsearch -integer $colrows($x) [expr {$b+$d}]] < 0} { set good 0; break }
        }
        if {$good} { lappend ok $x }
    }
    foreach x $ok { lappend slots [list $x $b] }
}
set use [lrange $slots 0 63]
set nloc 0
for {set k 0} {$k < 64} {incr k} {
    lassign [lindex $use $k] c yb
    foreach pair $stg($k) {
        lassign $pair si cell
        set be [expr {$si % 2 == 0 ? "A6LUT" : "B6LUT"}]
        set_property LOC "SLICE_X${c}Y[expr {$yb+$si}]" $cell
        set_property BEL $be $cell
        incr nloc
    }
}
puts ">> CRYPTO_PLACE_OK $nloc BR-PUF LUT3 locked"

catch { set_property SEVERITY {Warning} [get_drc_checks LUTLP-1] } e1
set loopnets [get_nets -hierarchical -quiet -filter {NAME =~ "*u_puf*g_ring*u_ring*n*"}]
set_property ALLOW_COMBINATORIAL_LOOPS TRUE $loopnets
puts ">> ALLOW_COMBINATORIAL_LOOPS on [llength $loopnets] nets"

read_checkpoint -cell u_ps   $ps7dcp

opt_design
place_design
route_design
report_timing_summary -file $root/logs/timing.rpt
report_utilization    -file $root/logs/util.rpt

set l3p [get_cells -hier -quiet -filter {NAME =~ "*u_puf*g_ring*u_ring*g_stage*" && REF_NAME == LUT3}]
puts ">> CRYPTO_POSTIMPL: BR-PUF LUT3 = [llength $l3p] (expect 1024)"
if {[llength $l3p] != 1024} { error "CRYPTO GATE FAIL: post-impl [llength $l3p] != 1024" }
set wnsc [get_property SLACK [get_timing_paths -quiet -max_paths 1]]
puts ">> CRYPTO_POSTIMPL: WNS = $wnsc ns (需 >= 0)"


write_checkpoint -force $root/pr_out/trustroot_uart_impl.dcp
write_bitstream -force $root/pr_out/trustroot_uart.bit
if {![file exists $root/pr_out/trustroot_uart.bit]} { error "bitstream missing" }
puts ">> BIT=$root/pr_out/trustroot_uart.bit"
puts ">> BUILD_DONE"
